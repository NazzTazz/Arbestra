DATABASE_URL=postgres://arbestra:arbestra@127.0.0.1:5432/arbestra
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
COOKIE_NAME=arbestra_session
# Production only, if sessions are intentionally shared across world subdomains:
# COOKIE_DOMAIN=.arbestra.world
SESSION_TTL_DAYS=30
# Development/test override. Omit in production to use catalog durations.
CONSTRUCTION_DURATION_MS=3000
SCHEDULED_TASK_POLL_INTERVAL_MS=250

# World generator: authenticated operator accounts, empty by default.
WORLD_GENERATOR_OPERATOR_EMAILS=
# Optional bounded executor settings (defaults):
# WORLD_GENERATOR_MAX_CELLS=131072
# WORLD_GENERATOR_TIMEOUT_MS=180000
# WORLD_GENERATOR_MEMORY_MB=768
